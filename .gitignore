local.properties

# Dictionaries used for local testing (large, third-party).
/*.zip
/dicts/

# Release signing secrets.
keystore.properties
*.jks
*.keystore

# Local OCR test images (third-party content, not redistributable).
/testdata/ocr/*
!/testdata/ocr/README.md

# Local dictionary collection for import tests (large, third-party).
/testdata/dictionaries/

# Private archive of the downloaded and converted dictionaries and OCR models (ai/notes/dictionary-archive.md).
/dictionary-archive/

# Backup of the AnkiDroid collection from the test emulator (personal data).
/testdata/anki-backup/

# Local builds of earlier releases for upgrade tests.
/testdata/apk/

# wordfreq word lists for frequency dictionary tests (third-party data).
/testdata/wordfreq/

# Tesseract models downloaded by scripts/ocr-models/tessdata_catalog.py
/testdata/tessdata/

# The Unicode Han database, the source of generated character tables.
/testdata/unihan/
node_modules/

# Written into source archives by the release workflow; builds from git read the version from tags.
/version.txt

# JVM crash logs (test executors out of memory)
hs_err_pid*.log
replay_pid*.log

# Python bytecode
__pycache__/
