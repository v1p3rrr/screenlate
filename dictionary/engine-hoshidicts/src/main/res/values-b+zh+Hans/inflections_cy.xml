    <string name="inflection_cy_aspirate_mutation_label">送气音变</string>
    <string name="inflection_cy_aspirate_mutation">送气音变：p t c 变为 ph th ch（cath → ei chath）</string>
    <string name="inflection_cy_h_prothesis_label">h 增音</string>
    <string name="inflection_cy_h_prothesis">元音前加 h（ysgol → ei hysgol）</string>
