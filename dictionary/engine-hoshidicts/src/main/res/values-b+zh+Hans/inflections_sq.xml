    <string name="inflection_sq_e_label">阴性或复数</string>
    <string name="inflection_sq_e">形容词的阴性或复数形式（modern → moderne、turistik → turistike）</string>
    <string name="inflection_sq_as_e_label">以 e 代 ë</string>
    <string name="inflection_sq_as_e">词尾的 ë 写作 e（gjatë → gjate、mirë → mire）</string>
    <string name="inflection_sq_a_label">阴性复数</string>
    <string name="inflection_sq_a">形容词的阴性复数形式（gjithë → gjitha、lartë → larta、vjetër → vjetra、vogël → vogla）</string>
    <string name="inflection_sq_me_label">阴性或复数</string>
    <string name="inflection_sq_me">以 -ëm 结尾的形容词的阴性或复数形式（sotëm → sotme、rëndësishëm → rëndësishme）</string>
    <string name="inflection_sq_het_label">中被动态</string>
    <string name="inflection_sq_het">现在时中被动态，第三人称（ndodh → ndodhet、ndodhen；shtrij → shtrihet；mendoj → mendohet）</string>
    <string name="inflection_sq_hej_label">中被动态过去未完成时</string>
    <string name="inflection_sq_hej">过去未完成时中被动态，第三人称单数（bëj → bëhej、formoj → formohej）</string>
    <string name="inflection_sq_uar_label">分词</string>
    <string name="inflection_sq_uar">分词，也用作阴性或复数形容词（bazoj → bazuar、banoj → banuara、shkruaj → shkruar、thirr → thirrur、mbet → mbetura、kthej → kthyer）</string>
    <string name="inflection_sq_ua_label">不定过去时</string>
    <string name="inflection_sq_ua">不定过去时，第三人称（përfundoj → përfundoi、botoj → botua、vërtetoj → vërtetuan、shkruaj → shkrua、kthej → kthye）</string>
    <string name="inflection_sq_on_label">现在时</string>
    <string name="inflection_sq_on">现在时，第三人称（datoj → daton、datojnë；hyj → hyjnë）</string>
    <string name="inflection_sq_onte_label">过去未完成时</string>
    <string name="inflection_sq_onte">过去未完成时，第三人称单数（numëroj → numëronte）</string>
    <string name="inflection_sq_i_label">定指形式</string>
    <string name="inflection_sq_i">阳性名词的定指形式（term → termi、sport → sporti）</string>
    <string name="inflection_sq_it_label">定指属格</string>
    <string name="inflection_sq_it">定指阳性名词的属格、与格或离格（sulm → sulmit、jug → jugut）</string>
    <string name="inflection_sq_in_label">定指宾格</string>
    <string name="inflection_sq_in">定指阳性名词的宾格（sulm → sulmin、ndikim → ndikimin）</string>
    <string name="inflection_sq_t_label">定指复数</string>
    <string name="inflection_sq_t">定指复数（aleat → aleatët、dokument → dokumentet）</string>
    <string name="inflection_sq_ve_label">复数属格</string>
    <string name="inflection_sq_ve">复数的属格、与格或离格（tipar → tipareve、shqiptar → shqiptarve、rrokje → rrokjeve）</string>
    <string name="inflection_sq_ia_label">定指形式</string>
    <string name="inflection_sq_ia">阴性名词的定指形式（industri → industria、shitje → shitja、gjermanishte → gjermanishtja）</string>
    <string name="inflection_sq_s_label">定指属格</string>
    <string name="inflection_sq_s">定指阴性名词的属格、与格或离格（drejtësi → drejtësisë、paqe → paqes、federatë → federatës）</string>
    <string name="inflection_sq_n_label">定指宾格</string>
    <string name="inflection_sq_n">定指阴性名词的宾格（leje → lejen、konferencë → konferencën）</string>
