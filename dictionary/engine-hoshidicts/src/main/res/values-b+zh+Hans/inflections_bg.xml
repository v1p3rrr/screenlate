<?xml version="1.0" encoding="utf-8"?>
<!-- Simplified Chinese translation of values/inflections_bg.xml. -->
<resources>
    <string name="inflection_bg_definite_label">定指形式</string>
    <string name="inflection_bg_definite">定冠词：-ът -ят -а -я、-та -то -те（градът、учителя、книгата、селото、книгите）</string>
    <string name="inflection_bg_plural_label">复数</string>
    <string name="inflection_bg_plural">复数：-и -ове -ища -а -та -ия（студенти、книги、градове、пътища、села、морета、събития）</string>
    <string name="inflection_bg_feminine_label">阴性</string>
    <string name="inflection_bg_feminine">形容词的阴性形式：-а（нова、умен → умна、добър → добра、българска）</string>
    <string name="inflection_bg_neuter_label">中性</string>
    <string name="inflection_bg_neuter">形容词的中性形式：-о（ново、умен → умно、добър → добро、българско、синьо）</string>
    <string name="inflection_bg_present_label">现在时</string>
    <string name="inflection_bg_present">现在时（гарантирам → гарантира、гарантират；чета → четеш、четат；говоря → говори）</string>
    <string name="inflection_bg_past_label">过去时</string>
    <string name="inflection_bg_past">不定过去时或未完成过去时（чакам → чаках、чакаше；чета → четох、четеше；говоря → говорих）</string>
    <string name="inflection_bg_past_participle_label">过去分词</string>
    <string name="inflection_bg_past_participle">以 -л 结尾的过去主动分词（гарантирам → гарантирал、измина → изминала、говоря → говорили）</string>
    <string name="inflection_bg_passive_participle_label">被动分词</string>
    <string name="inflection_bg_passive_participle">以 -н 结尾的过去被动分词（гарантирам → гарантиран、гарантирана；говоря → говорено）</string>
    <string name="inflection_bg_imperative_label">命令式</string>
    <string name="inflection_bg_imperative">命令式 -ай -айте（чакам → чакай、чакайте；стрелям → стреляй）</string>
</resources>
