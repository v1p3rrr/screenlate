    <string name="inflection_sw_class_label">clasă</string>
    <string name="inflection_sw_class">subiect al unei clase nominale: ki- vi- (kitabu kimeanguka), li- ya- (jina, majina), i- zi- (nyumba), ku- pa- mu- (locuri: kulikuwa, a fost)</string>
    <string name="inflection_sw_past_label">trecut</string>
    <string name="inflection_sw_past">trecut: li-; ku- după negație (alisoma, hakusoma)</string>
    <string name="inflection_sw_present_label">prezent</string>
    <string name="inflection_sw_present">prezent: na- (anasoma)</string>
    <string name="inflection_sw_future_label">viitor</string>
    <string name="inflection_sw_future">viitor: ta-; taka- înainte de relativ (atasoma, hatasoma, atakayesoma)</string>
    <string name="inflection_sw_perfect_label">perfect</string>
    <string name="inflection_sw_perfect">perfect: me- (amesoma, a citit)</string>
    <string name="inflection_sw_not_yet_label">încă nu</string>
    <string name="inflection_sw_not_yet">încă nu: ja- după negație (hajasoma, încă nu a citit)</string>
    <string name="inflection_sw_conditional_label">condițional</string>
    <string name="inflection_sw_conditional">condițional: nge- și ngali- (angesoma, ar citi; angalisoma, ar fi citit)</string>
    <string name="inflection_sw_when_label">când</string>
    <string name="inflection_sw_when">ki-: când, în timp ce sau dacă (akisoma)</string>
    <string name="inflection_sw_and_then_label">și apoi</string>
    <string name="inflection_sw_and_then">ka-: și apoi, într-o narațiune (akasoma)</string>
    <string name="inflection_sw_habitual_label">habitual</string>
    <string name="inflection_sw_habitual">habitual: hu- (husoma, citește de obicei)</string>
    <string name="inflection_sw_relative_label">relativ</string>
    <string name="inflection_sw_relative">relativ: care, unde (aliyesoma, cel care a citit; kinachoitwa, care se numește; waishio, care trăiesc)</string>
    <string name="inflection_sw_object_label">complement</string>
    <string name="inflection_sw_object">complement: ni- pe mine, ku- pe tine, m- sau mw- pe el/ea, tu- pe noi, wa- pe ei/ele și prefixele de clasă nominală ki- vi- li- ya- i- zi- u- pa- mu- (ninakupenda, alimwona)</string>
    <string name="inflection_sw_reflexive_label">reflexiv</string>
    <string name="inflection_sw_reflexive">reflexiv ji-: pe sine (alijificha, kujiunga)</string>
    <string name="inflection_sw_infinitive_label">infinitiv</string>
    <string name="inflection_sw_infinitive">infinitiv: ku- sau kw- (kusoma, kwandika, kumpa)</string>
