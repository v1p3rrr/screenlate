    <string name="inflection_sw_negative_label">negativ</string>
    <string name="inflection_sw_negative">negativ: ha- înaintea subiectului (hatukusoma, hakusoma), si- pentru eu și hu- pentru tu (sikusoma, hukusoma), si- după subiect înainte de relativ (isiyojulikana)</string>
