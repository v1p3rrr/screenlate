    <string name="inflection_sw_he_she_label">el/ea</string>
    <string name="inflection_sw_he_she">subiect a-: el sau ea (anasoma, alisoma)</string>
    <string name="inflection_sw_we_label">noi</string>
    <string name="inflection_sw_we">subiect tu-: noi (tunasoma, hatukusoma)</string>
