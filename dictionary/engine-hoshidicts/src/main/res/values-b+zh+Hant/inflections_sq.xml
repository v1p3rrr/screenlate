    <string name="inflection_sq_e_label">陰性或複數</string>
    <string name="inflection_sq_e">形容詞的陰性或複數形式（modern → moderne、turistik → turistike）</string>
    <string name="inflection_sq_as_e_label">以 e 代 ë</string>
    <string name="inflection_sq_as_e">詞尾的 ë 寫作 e（gjatë → gjate、mirë → mire）</string>
    <string name="inflection_sq_a_label">陰性複數</string>
    <string name="inflection_sq_a">形容詞的陰性複數形式（gjithë → gjitha、lartë → larta、vjetër → vjetra、vogël → vogla）</string>
    <string name="inflection_sq_me_label">陰性或複數</string>
    <string name="inflection_sq_me">以 -ëm 結尾的形容詞的陰性或複數形式（sotëm → sotme、rëndësishëm → rëndësishme）</string>
    <string name="inflection_sq_het_label">中被動態</string>
    <string name="inflection_sq_het">現在時中被動態，第三人稱（ndodh → ndodhet、ndodhen；shtrij → shtrihet；mendoj → mendohet）</string>
    <string name="inflection_sq_hej_label">中被動態過去未完成時</string>
    <string name="inflection_sq_hej">過去未完成時中被動態，第三人稱單數（bëj → bëhej、formoj → formohej）</string>
    <string name="inflection_sq_uar_label">分詞</string>
    <string name="inflection_sq_uar">分詞，也用作陰性或複數形容詞（bazoj → bazuar、banoj → banuara、shkruaj → shkruar、thirr → thirrur、mbet → mbetura、kthej → kthyer）</string>
    <string name="inflection_sq_ua_label">不定過去時</string>
    <string name="inflection_sq_ua">不定過去時，第三人稱（përfundoj → përfundoi、botoj → botua、vërtetoj → vërtetuan、shkruaj → shkrua、kthej → kthye）</string>
    <string name="inflection_sq_on_label">現在時</string>
    <string name="inflection_sq_on">現在時，第三人稱（datoj → daton、datojnë；hyj → hyjnë）</string>
    <string name="inflection_sq_onte_label">過去未完成時</string>
    <string name="inflection_sq_onte">過去未完成時，第三人稱單數（numëroj → numëronte）</string>
    <string name="inflection_sq_i_label">定指形式</string>
    <string name="inflection_sq_i">陽性名詞的定指形式（term → termi、sport → sporti）</string>
    <string name="inflection_sq_it_label">定指屬格</string>
    <string name="inflection_sq_it">定指陽性名詞的屬格、與格或離格（sulm → sulmit、jug → jugut）</string>
    <string name="inflection_sq_in_label">定指賓格</string>
    <string name="inflection_sq_in">定指陽性名詞的賓格（sulm → sulmin、ndikim → ndikimin）</string>
    <string name="inflection_sq_t_label">定指複數</string>
    <string name="inflection_sq_t">定指複數（aleat → aleatët、dokument → dokumentet）</string>
    <string name="inflection_sq_ve_label">複數屬格</string>
    <string name="inflection_sq_ve">複數的屬格、與格或離格（tipar → tipareve、shqiptar → shqiptarve、rrokje → rrokjeve）</string>
    <string name="inflection_sq_ia_label">定指形式</string>
    <string name="inflection_sq_ia">陰性名詞的定指形式（industri → industria、shitje → shitja、gjermanishte → gjermanishtja）</string>
    <string name="inflection_sq_s_label">定指屬格</string>
    <string name="inflection_sq_s">定指陰性名詞的屬格、與格或離格（drejtësi → drejtësisë、paqe → paqes、federatë → federatës）</string>
    <string name="inflection_sq_n_label">定指賓格</string>
    <string name="inflection_sq_n">定指陰性名詞的賓格（leje → lejen、konferencë → konferencën）</string>
</resources>
