<?xml version="1.0" encoding="utf-8"?>
<!-- Traditional Chinese translation of values/inflections_sw.xml. -->
<resources>
    <string name="inflection_sw_negative_label">否定</string>
    <string name="inflection_sw_negative">否定：主語前的 ha-（hatukusoma、hakusoma），「我」用 si-，「你」用 hu-（sikusoma、hukusoma），主語後、關係形式前的 si-（isiyojulikana）</string>
    <string name="inflection_sw_i_label">我</string>
    <string name="inflection_sw_i">主語 ni-：我（ninasoma、nilisoma）</string>
    <string name="inflection_sw_you_label">你</string>
    <string name="inflection_sw_you">主語 u-：你，或第 3、11、14 類名詞（unasoma；mti umeanguka，樹倒了）</string>
    <string name="inflection_sw_he_she_label">他/她</string>
    <string name="inflection_sw_he_she">主語 a-：他或她（anasoma、alisoma）</string>
    <string name="inflection_sw_we_label">我們</string>
    <string name="inflection_sw_we">主語 tu-：我們（tunasoma、hatukusoma）</string>
    <string name="inflection_sw_you_pl_label">你們</string>
    <string name="inflection_sw_you_pl">主語 m-：你們（mnasoma、hamkusoma）</string>
    <string name="inflection_sw_they_label">他們</string>
    <string name="inflection_sw_they">主語 wa-：他們（wanasoma、hawakusoma）</string>
    <string name="inflection_sw_class_label">名詞類</string>
    <string name="inflection_sw_class">名詞類的主語：ki- vi-（kitabu kimeanguka），li- ya-（jina、majina），i- zi-（nyumba），ku- pa- mu-（處所：kulikuwa，曾有）</string>
    <string name="inflection_sw_past_label">過去式</string>
    <string name="inflection_sw_past">過去式：li-，否定後用 ku-（alisoma、hakusoma）</string>
    <string name="inflection_sw_present_label">現在式</string>
    <string name="inflection_sw_present">現在式：na-（anasoma）</string>
    <string name="inflection_sw_future_label">未來式</string>
    <string name="inflection_sw_future">未來式：ta-，關係形式前用 taka-（atasoma、hatasoma、atakayesoma）</string>
    <string name="inflection_sw_perfect_label">完成貌</string>
    <string name="inflection_sw_perfect">完成貌：me-（amesoma，已讀）</string>
    <string name="inflection_sw_not_yet_label">尚未</string>
    <string name="inflection_sw_not_yet">尚未：否定後的 ja-（hajasoma，還沒讀）</string>
    <string name="inflection_sw_conditional_label">條件式</string>
    <string name="inflection_sw_conditional">條件式：nge- 和 ngali-（angesoma，會讀；angalisoma，本會讀過）</string>
    <string name="inflection_sw_when_label">當…時</string>
    <string name="inflection_sw_when">ki-：當…時、一邊…一邊或如果（akisoma）</string>
    <string name="inflection_sw_and_then_label">然後</string>
    <string name="inflection_sw_and_then">ka-：然後，用於敘述（akasoma）</string>
    <string name="inflection_sw_habitual_label">習慣</string>
    <string name="inflection_sw_habitual">習慣：hu-（husoma，通常讀）</string>
    <string name="inflection_sw_relative_label">關係形式</string>
    <string name="inflection_sw_relative">關係形式：…的人、…的東西、…的地方（aliyesoma，讀過的人；kinachoitwa，被稱為…的；waishio，居住的人們）</string>
    <string name="inflection_sw_object_label">受詞</string>
    <string name="inflection_sw_object">受詞：ni- 我，ku- 你，m- 或 mw- 他或她，tu- 我們，wa- 他們，以及名詞類字首 ki- vi- li- ya- i- zi- u- pa- mu-（ninakupenda、alimwona）</string>
    <string name="inflection_sw_reflexive_label">反身</string>
    <string name="inflection_sw_reflexive">反身 ji-：自己（alijificha、kujiunga）</string>
    <string name="inflection_sw_infinitive_label">不定詞</string>
    <string name="inflection_sw_infinitive">不定詞：ku- 或 kw-（kusoma、kwandika、kumpa）</string>
</resources>
