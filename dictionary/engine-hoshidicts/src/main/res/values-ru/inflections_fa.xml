    <string name="inflection_fa_ayd_label">2-е л. мн. ч.</string>
    <string name="inflection_fa_ayd">2-е лицо мн. ч. после ه: «вы есть» (خسته‌اید)</string>
    <string name="inflection_fa_aym_label">1-е л. мн. ч.</string>
    <string name="inflection_fa_aym">1-е лицо мн. ч. после ه: «мы есть» (خسته‌ایم)</string>
