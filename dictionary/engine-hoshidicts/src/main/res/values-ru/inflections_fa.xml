    <string name="inflection_fa_ytan_label">2-е л. мн. ч.</string>
    <string name="inflection_fa_ytan">2-е лицо мн. ч. после гласной: ваш (پایتان)</string>
    <string name="inflection_fa_yshan_label">3-е л. мн. ч.</string>
    <string name="inflection_fa_yshan">3-е лицо мн. ч. после гласной: их (پایشان)</string>
    <string name="inflection_fa_mvn_label">1-е л. мн. ч.</string>
    <string name="inflection_fa_mvn">1-е лицо мн. ч. в разговорной речи: наш (کتابمون) или нам (بهمون)</string>
    <string name="inflection_fa_tvn_label">2-е л. мн. ч.</string>
    <string name="inflection_fa_tvn">2-е лицо мн. ч. в разговорной речи: ваш (کتابتون) или вам (بهتون)</string>
    <string name="inflection_fa_shvn_label">3-е л. мн. ч.</string>
