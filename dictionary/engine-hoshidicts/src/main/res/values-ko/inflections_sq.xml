    <string name="inflection_sq_as_e_label">ë 대신 e</string>
    <string name="inflection_sq_as_e">어말 ë를 e로 쓴 형태 (gjatë → gjate, mirë → mire)</string>
    <string name="inflection_sq_a_label">여성 복수형</string>
    <string name="inflection_sq_a">형용사의 여성 복수형 (gjithë → gjitha, lartë → larta, vjetër → vjetra, vogël → vogla)</string>
    <string name="inflection_sq_me_label">여성형·복수형</string>
    <string name="inflection_sq_me">-ëm으로 끝나는 형용사의 여성형 또는 복수형 (sotëm → sotme, rëndësishëm → rëndësishme)</string>
    <string name="inflection_sq_het_label">중간수동태</string>
    <string name="inflection_sq_het">현재 중간수동태, 3인칭 (ndodh → ndodhet, ndodhen; shtrij → shtrihet; mendoj → mendohet)</string>
    <string name="inflection_sq_hej_label">중간수동태 불완료과거</string>
    <string name="inflection_sq_hej">불완료과거 중간수동태, 3인칭 단수 (bëj → bëhej, formoj → formohej)</string>
    <string name="inflection_sq_uar_label">분사</string>
    <string name="inflection_sq_uar">분사, 여성형이나 복수형 형용사로도 쓰임 (bazoj → bazuar, banoj → banuara, shkruaj → shkruar, thirr → thirrur, mbet → mbetura, kthej → kthyer)</string>
    <string name="inflection_sq_ua_label">아오리스트</string>
    <string name="inflection_sq_ua">아오리스트, 3인칭 (përfundoj → përfundoi, botoj → botua, vërtetoj → vërtetuan, shkruaj → shkrua, kthej → kthye)</string>
    <string name="inflection_sq_on_label">현재</string>
    <string name="inflection_sq_on">현재, 3인칭 (datoj → daton, datojnë; hyj → hyjnë)</string>
    <string name="inflection_sq_onte_label">불완료과거</string>
    <string name="inflection_sq_onte">불완료과거, 3인칭 단수 (numëroj → numëronte)</string>
    <string name="inflection_sq_i_label">한정형</string>
    <string name="inflection_sq_i">남성 명사의 한정형 (term → termi, sport → sporti)</string>
    <string name="inflection_sq_it_label">한정 속격</string>
    <string name="inflection_sq_it">한정형 남성 명사의 속격, 여격 또는 탈격 (sulm → sulmit, jug → jugut)</string>
    <string name="inflection_sq_in_label">한정 대격</string>
    <string name="inflection_sq_in">한정형 남성 명사의 대격 (sulm → sulmin, ndikim → ndikimin)</string>
    <string name="inflection_sq_t_label">한정 복수</string>
    <string name="inflection_sq_t">한정형 복수 (aleat → aleatët, dokument → dokumentet)</string>
    <string name="inflection_sq_ve_label">복수 속격</string>
    <string name="inflection_sq_ve">복수의 속격, 여격 또는 탈격 (tipar → tipareve, shqiptar → shqiptarve, rrokje → rrokjeve)</string>
    <string name="inflection_sq_ia_label">한정형</string>
    <string name="inflection_sq_ia">여성 명사의 한정형 (industri → industria, shitje → shitja, gjermanishte → gjermanishtja)</string>
    <string name="inflection_sq_s_label">한정 속격</string>
    <string name="inflection_sq_s">한정형 여성 명사의 속격, 여격 또는 탈격 (drejtësi → drejtësisë, paqe → paqes, federatë → federatës)</string>
    <string name="inflection_sq_n_label">한정 대격</string>
